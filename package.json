{
  "name": "aira-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node --import tsx scripts/start.ts",
    "proxy:install": "node --import tsx scripts/nginx.ts install",
    "proxy:start": "node --import tsx scripts/nginx.ts start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:stop": "node --import tsx scripts/stop.ts",
    "runtime:build": "docker build -t aira-nexus-runtime:0.1 runtime",
    "format": "prettier --write src test scripts *.json *.mjs *.ts runtime/*.py"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.29",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.19.1",
    "lucide-react": "1.71.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.3.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.6.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
